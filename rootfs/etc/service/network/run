#!/bin/sh
# DHCP on every ethernet interface, kept alive by ennead
exec 2>&1
PATH=/bin:/sbin:/usr/bin:/usr/sbin
ip link set lo up 2>/dev/null
for i in /sys/class/net/*; do
  n=${i##*/}
  [ "$n" = lo ] && continue
  ip link set "$n" up 2>/dev/null
done
IF=
for i in /sys/class/net/*; do
  n=${i##*/}
  [ "$n" = lo ] && continue
  IF=$n; break
done
[ -n "$IF" ] || { echo "network: no interface found"; sleep 5; exit 1; }
# stay in foreground so the lease is renewed; ennead restarts it if it dies
exec udhcpc -f -i "$IF" -s /usr/share/udhcpc/default.script -t 5 -T 3 -A 5
