#!/bin/sh
set -e

umask 022
test -d package || sh -cx '! : Wrong working directory.'
test -d src || sh -cx '! : Wrong working directory.'

here=`env - PATH=$PATH pwd`
parent=`dirname $here`

echo 'Creating symlink atum -> atum-2.3.1...'
rm -f atum
ln -s atum-2.3.1 atum
mv -f atum ..

echo 'Making command links in /command...'
mkdir -p /command
for i in `cat package/commands`; do
  rm -f /command/$i'{new}'
  ln -s $parent/atum/command/$i /command/$i'{new}'
  mv -f /command/$i'{new}' /command/$i
done
if test -e /command/utmpset; then
  echo 'Removing utmpset from /command...'
  rm -f /command/utmpset
fi

echo 'Making compatibility links in /usr/local/bin...'
mkdir -p /usr/local/bin
for i in `cat package/commands`; do
  rm -f /usr/local/bin/$i'{new}'
  ln -s /command/$i /usr/local/bin/$i'{new}'
  mv -f /usr/local/bin/$i'{new}' /usr/local/bin/$i
done
if test -e /usr/local/bin/utmpset; then
  echo 'Removing utmpset from /usr/local/bin...'
  rm -f /usr/local/bin/utmpset
fi
