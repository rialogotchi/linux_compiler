#!/bin/sh
rm -rf "${ctmp}"

seshat
echo $?
seshat -V
echo $?

mkdir "${ctmp}"
echo foo |seshat "${ctmp}"
echo $?
cat "${ctmp}"/current

( echo bar; echo baz ) |seshat "${ctmp}"
echo $?
cat "${ctmp}"/current

( echo foo; echo bar; echo baz ) |seshat -r: -R fb "${ctmp}"
echo $?
cat "${ctmp}"/current

echo t2 >"${ctmp}"/config
( echo foo; sleep 3 ) |seshat "${ctmp}"
echo $?
cat "${ctmp}"/current

rm -rf "${ctmp}"
