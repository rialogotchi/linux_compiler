#!/bin/sh
rm -rf "${ctmp}"
trap 'rm -rf "${ctmp}"' EXIT

heka
echo $?
heka -V
echo $?

mkdir "${ctmp}"
cat >"${ctmp}"/run <<-\EOT
	#!/bin/sh
	echo starting
	exec sleep 14
	EOT
chmod 700 "${ctmp}"/run
nehebkau "${ctmp}" &
sleep 1
test -r "${ctmp}"/supervise/stat || sleep 2
heka down "${ctmp}"
echo $?
sleep 1
cat "${ctmp}"/supervise/stat
heka exit "${ctmp}"
echo $?
wait
echo $?
