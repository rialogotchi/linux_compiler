#!/bin/sh
# Bir kez calisir: DHCP, ping, DNS, NTP, HTTPS dener; sonucu tum konsollara yazar.
PATH=/sbin:/bin:/usr/sbin:/usr/bin
say() { echo "<4>atum-netcheck: $*" > /dev/kmsg; }
n=0
while [ $n -lt 90 ]; do
  ip route 2>/dev/null | grep -q '^default' && break
  n=$((n+1)); sleep 1
done
ip route 2>/dev/null | grep -q '^default' || { say "FAIL: varsayilan rota yok (DHCP basarisiz / ag karti yok)"; exit 1; }
say "ag hazir: $(ip -4 -o addr show scope global | awk '{printf "%s %s  ", $2, $4}')"
ping -c1 -W3 1.1.1.1 >/dev/null 2>&1 && say "ping 1.1.1.1 OK" || say "ping 1.1.1.1 yanit yok (ICMP filtreli olabilir)"
nslookup example.com >/dev/null 2>&1 && say "DNS OK" || { say "FAIL: DNS"; exit 1; }
ntpd -q -n -p pool.ntp.org >/dev/null 2>&1 && say "NTP saat esitleme OK" || say "NTP basarisiz (saat yanlis olabilir)"
wget -q -T 20 -O /dev/null https://example.com && say "HTTPS OK" || { say "FAIL: HTTPS"; exit 1; }
say "ATUM-NET-OK internet erisimi tamam"
