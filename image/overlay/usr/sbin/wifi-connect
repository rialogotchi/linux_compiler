#!/bin/sh
# kullanim: wifi-connect SSID [PAROLA]     (WIFI_COUNTRY=TR wifi-connect ... ile ulke kodu)
[ $# -ge 1 ] || { echo "kullanim: wifi-connect SSID [PAROLA]"; exit 1; }
command -v wpa_supplicant >/dev/null 2>&1 || { echo "wpa_supplicant yok (imaj wifi=false ile uretilmis)"; exit 1; }
mkdir -p /etc/wpa_supplicant
{
  echo "ctrl_interface=/run/wpa_supplicant"
  echo "update_config=1"
  echo "country=${WIFI_COUNTRY:-TR}"
  if [ -n "$2" ]; then
    wpa_passphrase "$1" "$2" | grep -v '#psk'
  else
    printf 'network={\n\tssid="%s"\n\tkey_mgmt=NONE\n}\n' "$1"
  fi
} > /etc/wpa_supplicant/wpa_supplicant.conf.new
chmod 600 /etc/wpa_supplicant/wpa_supplicant.conf.new
mv /etc/wpa_supplicant/wpa_supplicant.conf.new /etc/wpa_supplicant/wpa_supplicant.conf
killall wpa_supplicant 2>/dev/null
for s in /service/net-*; do
  [ -e "$s" ] && heka restart "$s" >/dev/null 2>&1
done
echo "Ayar yazildi; baglanti birkac saniye icinde kurulur (ip addr / ping 1.1.1.1)."
