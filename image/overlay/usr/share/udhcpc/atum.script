#!/bin/sh
# udhcpc olay betigi
PATH=/sbin:/bin:/usr/sbin:/usr/bin
[ -n "$interface" ] || exit 1
case "$1" in
  deconfig)
    ip -4 addr flush dev "$interface"
    ip link set dev "$interface" up
    ;;
  bound|renew)
    ip addr replace "$ip/${mask:-24}" ${broadcast:+broadcast $broadcast} dev "$interface"
    if [ -n "$router" ]; then
      for r in $router; do
        ip route replace default via "$r" dev "$interface" metric 100
        break
      done
    fi
    if [ -n "$dns" ]; then
      {
        [ -n "$domain" ] && echo "search $domain"
        for d in $dns; do echo "nameserver $d"; done
      } > /etc/resolv.conf.new && cat /etc/resolv.conf.new > /etc/resolv.conf
      rm -f /etc/resolv.conf.new
    fi
    ;;
esac
exit 0
