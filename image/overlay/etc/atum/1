#!/bin/sh
# STAGE 1: tek seferlik sistem hazirligi
PATH=/sbin:/bin:/usr/sbin:/usr/bin
exec 2>&1

mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys  || mount -t sysfs sysfs /sys
mountpoint -q /dev  || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mountpoint -q /dev/pts || mount -t devpts -o gid=5,mode=620 devpts /dev/pts
mountpoint -q /dev/shm || mount -t tmpfs -o mode=1777,nosuid,nodev shm /dev/shm
mountpoint -q /run || mount -t tmpfs -o mode=0755,nosuid,nodev run /run
mountpoint -q /tmp || mount -t tmpfs -o mode=1777,nosuid,nodev tmp /tmp
mount -o remount,rw / 2>/dev/null
mkdir -p /run/atum/svc /run/udev /var/log /var/tmp

hostname -F /etc/hostname 2>/dev/null
ip link set lo up 2>/dev/null

# kernel modulleri (dosyada olanlar; olmayanlar sessizce atlanir)
if [ -f /etc/modules ]; then
  grep -v '^#' /etc/modules | while read -r m _; do
    [ -n "$m" ] && modprobe -q "$m" 2>/dev/null
  done
fi
sysctl -q -p /etc/sysctl.d/atum.conf 2>/dev/null

# udev: donanim algilama, modul ve firmware yukleme, ag kartlari icin servis uretimi
if [ -x /sbin/udevd ]; then
  /sbin/udevd --daemon
  udevadm trigger --type=subsystems --action=add
  udevadm trigger --type=devices --action=add
  udevadm settle --timeout=30
fi

touch /etc/atum/stopit
chmod 0 /etc/atum/stopit
[ -e /etc/atum/reboot ] && chmod 0 /etc/atum/reboot
exit 0
